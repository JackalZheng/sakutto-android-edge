+        }
+    }
+    // output projection (Q6_K, 107520 rows; > maxStorageBufferBindingSize on Adreno), decode only
+    test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q6_K, GGML_TYPE_F32, 107520, 1, n_embd, {1, 1}, {1, 1}));
+
+    for (int64_t n : { (int64_t) 1, (int64_t) 41 }) {
+        test_cases.emplace_back(new test_get_rows(GGML_TYPE_Q4_K, n_embd, 4096, (int) n));   // token_embd
+        test_cases.emplace_back(new test_get_rows(GGML_TYPE_F32,  n_embd, (int) n, 1));      // inp_out_ids
