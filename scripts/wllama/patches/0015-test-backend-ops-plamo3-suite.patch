+// Shapes and types the PLaMo 3 Translate 0.8B Q4_K_M GGUF actually uses
+// (n_embd 1536, 16 query heads / 1 KV head of dim 128, n_ff 6144 packed as a
+// 12288-wide SwiGLU up projection, vocab 107520; weights Q4_K / Q6_K; KV cache
+// F16; NEOX RoPE with YaRN on full-attention layers, base 10000 on SWA layers).
+// Token counts cover decode (1), small batches and a typical paragraph prompt.
+static std::vector<std::unique_ptr<test_case>> make_test_cases_sakutto_plamo3() {
+    std::vector<std::unique_ptr<test_case>> test_cases;
+    const int64_t n_embd = 1536, head_dim = 128, n_head = 16, n_ff = 6144;
+    const int64_t ns[] = { 1, 2, 8, 16, 41, 128 };
+
+    struct weight_shape { ggml_type type; int64_t m; int64_t k; };
+    const weight_shape weights[] = {
+        { GGML_TYPE_Q6_K, 2304,   n_embd }, // attn_qkv (layers 0,1,4,7,10,13,14,15)
+        { GGML_TYPE_Q4_K, 2304,   n_embd }, // attn_qkv (other layers)
+        { GGML_TYPE_Q4_K, n_embd, 2048   }, // attn_output
+        { GGML_TYPE_Q4_K, 2*n_ff, n_embd }, // ffn_up (gate+up packed)
+        { GGML_TYPE_Q6_K, n_embd, n_ff   }, // ffn_down (Q6_K layers)
+        { GGML_TYPE_Q4_K, n_embd, n_ff   }, // ffn_down (Q4_K layers)
+    };
+    for (const auto & w : weights) {
+        for (int64_t n : ns) {
