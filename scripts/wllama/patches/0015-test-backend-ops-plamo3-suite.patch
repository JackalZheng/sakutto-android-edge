+        test_cases.emplace_back(new test_rms_norm_mul_add(GGML_TYPE_F32, {n_embd, n, 1, 1}, 1e-6f, false, false));
+        test_cases.emplace_back(new test_bin_bcast(ggml_mul, GGML_TYPE_F32, {n_embd, 1, 1, 1}, {1, (int) n, 1, 1}));
+        test_cases.emplace_back(new test_bin_bcast(ggml_add, GGML_TYPE_F32, {n_embd, n, 1, 1}, {1, 1, 1, 1}));
