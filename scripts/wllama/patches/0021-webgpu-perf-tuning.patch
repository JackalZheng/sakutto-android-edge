 // D3D12 on AMD and Intel commonly grants 2 GiB - 4. Keep a conservative cap
 // for the retry ladder and for debug profiles; requesting <= adapter limits
 // should succeed per spec (the first try is still adapter-max).
+// Sakutto patch 0021: tuning / diagnostics tokens after the profile name, e.g.
+// "adreno-matvec+sub32+perf". Returns whether `token` is one of them.
+static bool ggml_webgpu_debug_has_token(const char * token) {
+#ifdef __EMSCRIPTEN__
+    return EM_ASM_INT(
+               {
+                   var v = (typeof globalThis !== 'undefined' && globalThis.__SAKUTTO_WEBGPU_DEBUG__) ?
+                               String(globalThis.__SAKUTTO_WEBGPU_DEBUG__) :
+                               '';
+                   return v.split('+').slice(1).indexOf(UTF8ToString($0)) >= 0 ? 1 : 0;
+               },
+               token) != 0;
+#else
+    const char * v = getenv("SAKUTTO_WEBGPU_DEBUG");
+    if (v == nullptr) {
+        return false;
+    }
+    std::string rest(v);
+    size_t      pos = rest.find('+');
+    while (pos != std::string::npos) {
+        const size_t next = rest.find('+', pos + 1);
+        if (rest.substr(pos + 1, next == std::string::npos ? std::string::npos : next - pos - 1) == token) {
+            return true;
+        }
+        pos = next;
+    }
+    return false;
+#endif
+}
