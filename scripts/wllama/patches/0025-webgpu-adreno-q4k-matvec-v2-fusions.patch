+            let l0 = (chunk % 2u) * 16u;         // first byte of the chunk within the group's 32 bytes
+            // src1 vec4 index of x[block*256 + 64j + l0]; the high nibbles pair with +32 values.
+            let xb = src1_base + block * 64u + j * 16u + l0 / 4u;
+            let xl0 = src1[xb];
+            let xl1 = src1[xb + 1u];
+            let xl2 = src1[xb + 2u];
+            let xl3 = src1[xb + 3u];
+            let xh0 = src1[xb + 8u];
+            let xh1 = src1[xb + 9u];
+            let xh2 = src1[xb + 10u];
+            let xh3 = src1[xb + 11u];
+            let one = vec4<f32>(1.0);
+            let sum_lo = dot(xl0 + xl1 + xl2 + xl3, one);
+            let sum_hi = dot(xh0 + xh1 + xh2 + xh3, one);
+
+            for (var r = 0u; r < ROWS_PER_GROUP; r++) {
+                let row = row_base + group * ROWS_PER_GROUP + r;
+                if (row < params.m) {
+                    let blk = (src0_batch_offset + row * params.stride_01 + block) * BLOCK_VEC4;
+                    acc[r] += chunk_dot(blk, chunk, j, xl0, xl1, xl2, xl3, xh0, xh1, xh2, xh3, sum_lo, sum_hi);
+#ifdef GLU
+                    let blk_up = (src0_batch_offset + (row + params.m) * params.stride_01 + block) * BLOCK_VEC4;
+                    acc_up[r] += chunk_dot(blk_up, chunk, j, xl0, xl1, xl2, xl3, xh0, xh1, xh2, xh3, sum_lo, sum_hi);
+#endif
