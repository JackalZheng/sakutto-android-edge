+    // ROWS_PER_GROUP <= 4: vector accumulators rather than private arrays (a dynamically indexed
+    // private array can be placed in slow memory by the Adreno compiler, cf. the SOFT_MAX cache).
+    var acc = vec4<f32>(0.0);
+    var acc_up = vec4<f32>(0.0);
