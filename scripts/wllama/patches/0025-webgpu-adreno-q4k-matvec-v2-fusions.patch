+// Sakutto patch 0025: MUL_MAT (q4_K gate+up, one column) + SWIGLU -> mul_mat_vec_q4k_v2 GLU (token mvglu;
+// independent of q4v2, whose q4v2r*/q4v2t* shape tokens it shares).
+static bool ggml_webgpu_sakutto_can_fuse_mv_glu(webgpu_context & ctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    if (!ggml_webgpu_sakutto_fuse_mv_glu || ctx->global_ctx->disable_mat_vec ||
+        !ggml_can_fuse_subgraph(cgraph, node_idx, { GGML_OP_MUL_MAT, GGML_OP_GLU }, { node_idx + 1 })) {
+        return false;
+    }
+    const ggml_tensor * mm   = cgraph->nodes[node_idx];
+    const ggml_tensor * glu  = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * src0 = mm->src[0];
+    const ggml_tensor * src1 = mm->src[1];
+    if (glu->src[0] != mm || glu->src[1] != nullptr || ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU ||
+        ggml_get_op_params_i32(glu, 1) != 0) {
+        return false;
+    }
+    if (src0->type != GGML_TYPE_Q4_K || src1->type != GGML_TYPE_F32 || mm->type != GGML_TYPE_F32 ||
+        glu->type != GGML_TYPE_F32 || src0->ne[0] % 256 != 0 || mm->ne[1] != 1 || mm->ne[0] % 2 != 0 ||
+        glu->ne[0] * 2 != mm->ne[0] || glu->ne[1] != 1 || ggml_nrows(src0) != src0->ne[1] ||
+        ggml_nrows(src1) != 1 || ggml_nrows(glu) != 1 || !ggml_is_contiguous(glu) || src1->nb[0] != sizeof(float) ||
+        ggml_webgpu_can_use_mmvq(src0, src1, 1, ctx->global_ctx->capabilities.supports_dot_product,
+                                 ctx->global_ctx->vendor) ||
+        ggml_webgpu_tensor_binding_overlap(ctx->global_ctx, src0, src1) ||
+        (ggml_webgpu_tensor_misalignment(ctx, src1) / sizeof(float)) % 4 != 0) {
+        return false;
+    }
+    return true;
+}
+
+static webgpu_encoded_op ggml_webgpu_sakutto_mul_mat_swiglu(webgpu_context & ctx,
+                                                            ggml_tensor *    src0,
+                                                            ggml_tensor *    src1,
+                                                            ggml_tensor *    glu) {
+    ggml_webgpu_shader_lib_context shader_lib_ctx = {};
+    shader_lib_ctx.src0                 = src0;
+    shader_lib_ctx.src1                 = src1;
+    shader_lib_ctx.dst                  = glu;  // one column
+    shader_lib_ctx.max_wg_size          = ctx->global_ctx->capabilities.limits.maxComputeInvocationsPerWorkgroup;
+    shader_lib_ctx.supports_subgroups   = ctx->global_ctx->capabilities.supports_subgroups;
+    shader_lib_ctx.supports_dot_product = ctx->global_ctx->capabilities.supports_dot_product;
+    shader_lib_ctx.vendor               = ctx->global_ctx->vendor;
+    shader_lib_ctx.sakutto_q4v2         = true;
+    shader_lib_ctx.sakutto_q4v2_glu     = true;
+    webgpu_pipeline pipeline            = ctx->shader_lib->get_mul_mat_vec_pipeline(shader_lib_ctx, false);
+    auto * decisions = static_cast<ggml_webgpu_mul_mat_vec_shader_decisions *>(pipeline.context.get());
+
+    const size_t          bs0    = ggml_type_size(src0->type);
+    std::vector<uint32_t> params = {
+        (uint32_t) (ggml_webgpu_tensor_misalignment(ctx, src0) / bs0),
+        (uint32_t) (ggml_webgpu_tensor_misalignment(ctx, src1) / sizeof(float)),
+        (uint32_t) (ggml_webgpu_tensor_misalignment(ctx, glu) / sizeof(float)),
+        (uint32_t) glu->ne[0],  // output rows; weight rows o and o + m
+        1u,
+        (uint32_t) src0->ne[0],
+        (uint32_t) (src0->nb[1] / bs0),
+        (uint32_t) (src1->nb[1] / sizeof(float)),
+        (uint32_t) (src0->nb[2] / bs0),
+        (uint32_t) (src1->nb[2] / sizeof(float)),
+        (uint32_t) (src0->nb[3] / bs0),
+        (uint32_t) (src1->nb[3] / sizeof(float)),
+        1u, 1u, 1u, 1u,
+    };
+    std::vector<wgpu::BindGroupEntry> entries = {
+        ggml_webgpu_make_tensor_bind_group_entry(ctx, 0, src0),
+        ggml_webgpu_make_tensor_bind_group_entry(ctx, 1, src1),
+        ggml_webgpu_make_tensor_bind_group_entry(ctx, 2, glu),
+    };
+    uint32_t wg_x = 1;
+    uint32_t wg_y = 1;
+    compute_2d_workgroups(CEIL_DIV(glu->ne[0], decisions->outputs_per_wg),
+                          ctx->global_ctx->capabilities.limits.maxComputeWorkgroupsPerDimension, wg_x, wg_y);
+    return ggml_backend_webgpu_build(ctx, pipeline, params, entries, wg_x, wg_y);
+}
