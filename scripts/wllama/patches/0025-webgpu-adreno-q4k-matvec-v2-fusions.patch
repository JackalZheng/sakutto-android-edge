+    var sum2 = 0.0f;
+    for (var col = lid; col < params.ne0; col += WG_SIZE) {
+        let v = act[row_a + col] * scale1 * w1_at(row_w1 + col % params.w1_ne0) + act[row_r + col];
+        act[row_s + col] = v;
+        sum2 += v * v;
+    }
