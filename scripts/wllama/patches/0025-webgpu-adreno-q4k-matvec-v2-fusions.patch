+            for (var i = 0u; i < TPR; i++) {
+                total += partial_sums[thread_id * TPR + i];
+            }
+#ifdef GLU
+            var up = 0.0;
+            for (var i = 0u; i < TPR; i++) {
+                up += partial_sums[(OUTPUTS + thread_id) * TPR + i];
+            }
+            total = total / (1.0 + exp(-total)) * up;
+#endif
+            dst[dst_idx_base + thread_id] = total;
+        }
+    }
