+#ifdef SECOND_NORM
+    let row_y = params.offset_y + i3 * params.stride_y3 + i2 * params.stride_y2 + i1 * params.stride_y1;
+    let row_w2 = params.offset_w2 + (i3 % params.w2_ne3) * params.stride_w2_3 +
+                 (i2 % params.w2_ne2) * params.stride_w2_2 + (i1 % params.w2_ne1) * params.stride_w2_1;
+    sum2 = reduce_sum(lid, sum2);
+    let scale2 = 1.0 / sqrt(sum2 / f32(params.ne0) + params.eps2);
+    for (var col = lid; col < params.ne0; col += WG_SIZE) {
+        act[row_y + col] = act[row_s + col] * scale2 * w2_at(row_w2 + col % params.w2_ne0);
+    }
+#endif
+}
