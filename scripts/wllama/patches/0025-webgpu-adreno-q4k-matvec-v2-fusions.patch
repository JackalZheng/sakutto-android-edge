+    let dot_hi = dot(nibbles_hi(q.x), xh0) + dot(nibbles_hi(q.y), xh1) +
+                 dot(nibbles_hi(q.z), xh2) + dot(nibbles_hi(q.w), xh3);
+    return dd.x * (sm_lo.x * dot_lo + sm_hi.x * dot_hi) - dd.y * (sm_lo.y * sum_lo + sm_hi.y * sum_hi);
