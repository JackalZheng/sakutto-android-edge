+static std::optional<webgpu_encoded_op> ggml_webgpu_sakutto_norm_add(webgpu_context &           ctx,
+                                                                     const struct ggml_cgraph * cgraph,
+                                                                     int                        node_idx,
+                                                                     int                        n_fused) {
+    ggml_tensor * norm1 = cgraph->nodes[node_idx];
+    ggml_tensor * mul1  = cgraph->nodes[node_idx + 1];
+    ggml_tensor * s     = cgraph->nodes[node_idx + 2];
+    ggml_tensor * a     = norm1->src[0];
+    ggml_tensor * w1    = mul1->src[0] == norm1 ? mul1->src[1] : mul1->src[0];
+    ggml_tensor * r     = s->src[0] == mul1 ? s->src[1] : s->src[0];
+    const bool    two   = n_fused == 5;
+    ggml_tensor * norm2 = two ? cgraph->nodes[node_idx + 3] : nullptr;
+    ggml_tensor * y     = two ? cgraph->nodes[node_idx + 4] : s;
+    ggml_tensor * w2    = two ? (y->src[0] == norm2 ? y->src[1] : y->src[0]) : w1;
+
+    // activations: one buffer; any two equal (in-place) or disjoint in bytes
+    ggml_tensor * acts[4] = { a, r, s, y };
+    for (int i = 0; i < 4; i++) {
+        if (acts[i]->buffer != a->buffer) {
+            return std::nullopt;
+        }
+        for (int j = i + 1; j < 4; j++) {
+            const size_t oi = ggml_webgpu_tensor_offset(acts[i]);
+            const size_t oj = ggml_webgpu_tensor_offset(acts[j]);
+            const size_t ni = ggml_nbytes(acts[i]);
+            const size_t nj = ggml_nbytes(acts[j]);
+            const bool   equal    = oi == oj && ni == nj;
+            const bool   disjoint = oi + ni <= oj || oj + nj <= oi;
+            if (!equal && !disjoint) {
+                return std::nullopt;
+            }
+        }
+    }
+    ggml_webgpu_merged_binding_range range = ggml_webgpu_tensor_merged_binding_range(ctx, { a, r, s, y });
+    bool w_merged = false;
+    for (ggml_tensor * w : { w1, w2 }) {
+        if (ggml_webgpu_tensor_binding_overlap_range(ctx->global_ctx, w, a->buffer, range.offset, range.size)) {
+            w_merged = true;
+        }
+    }
+    if (w_merged) {
+        if (w1->buffer != a->buffer || w2->buffer != a->buffer) {
+            return std::nullopt;
+        }
+        range = ggml_webgpu_tensor_merged_binding_range(ctx, { a, r, s, y, w1, w2 });
+    }
+    if (range.size > ctx->global_ctx->capabilities.limits.maxStorageBufferBindingSize) {
+        return std::nullopt;
+    }
+
+    const auto el  = [](const ggml_tensor * t, int d) { return (uint32_t) (t->nb[d] / sizeof(float)); };
+    const auto off = [&](const ggml_tensor * t) { return ggml_webgpu_tensor_merged_element_offset(t, range); };
+    const auto woff = [&](ggml_tensor * t) {
+        return w_merged ? off(t) : (uint32_t) (ggml_webgpu_tensor_misalignment(ctx, t) / sizeof(float));
+    };
+    const float eps1 = ggml_get_op_params_f32(norm1, 0);
+    const float eps2 = two ? ggml_get_op_params_f32(norm2, 0) : eps1;
+
+    std::vector<uint32_t> params = {
+        off(a), off(r), off(s), off(y), woff(w1), woff(w2),
+        el(a, 1), el(a, 2), el(a, 3),
+        el(r, 1), el(r, 2), el(r, 3),
+        el(s, 1), el(s, 2), el(s, 3),
+        el(y, 1), el(y, 2), el(y, 3),
+        (uint32_t) w1->ne[0], (uint32_t) w1->ne[1], (uint32_t) w1->ne[2], (uint32_t) w1->ne[3],
+        el(w1, 1), el(w1, 2), el(w1, 3),
+        (uint32_t) w2->ne[0], (uint32_t) w2->ne[1], (uint32_t) w2->ne[2], (uint32_t) w2->ne[3],
+        el(w2, 1), el(w2, 2), el(w2, 3),
+        (uint32_t) s->ne[0], (uint32_t) s->ne[1], (uint32_t) s->ne[2], (uint32_t) s->ne[3],
+        ggml_webgpu_u32_from_f32(eps1), ggml_webgpu_u32_from_f32(eps2),
+    };
+
+    ggml_webgpu_shader_lib_context shader_lib_ctx = {};
+    shader_lib_ctx.src0        = a;
+    shader_lib_ctx.dst         = y;
+    shader_lib_ctx.max_wg_size = ctx->global_ctx->capabilities.limits.maxComputeInvocationsPerWorkgroup;
+    webgpu_pipeline pipeline   = ctx->shader_lib->get_sakutto_norm_add_pipeline(shader_lib_ctx, two, w_merged);
+
+    std::vector<wgpu::BindGroupEntry> entries;
+    entries.push_back(ggml_webgpu_make_bind_group_entry(0, ggml_webgpu_tensor_buf(a), range.offset, range.size));
+    if (!w_merged) {
+        entries.push_back(ggml_webgpu_make_tensor_bind_group_entry(ctx, 1, w1));
+        if (two) {
+            entries.push_back(ggml_webgpu_make_tensor_bind_group_entry(ctx, 2, w2));
+        }
+    }
+
+    uint32_t wg_x;
+    uint32_t wg_y;
+    compute_2d_workgroups(ggml_nrows(s), ctx->global_ctx->capabilities.limits.maxComputeWorkgroupsPerDimension, wg_x,
+                          wg_y);
+    return ggml_backend_webgpu_build(ctx, pipeline, params, entries, wg_x, wg_y);
+}
