+// Sakutto patch 0025: fused post-norm residual chain
+//   s = rms_norm(a) * w1 + r          (RMS_NORM, MUL, ADD)
+//   y = rms_norm(s) * w2              (RMS_NORM, MUL; only with SECOND_NORM)
+// as in PLaMo 3 / Gemma post-norm blocks (attn_post_norm -> residual add -> ffn_norm), after the
+// fused rms_norm+mul+add kernels of llama.cpp ggml-opencl (kernel_rms_norm_mul_add) and ggml-vulkan.
+// One workgroup per row. Each thread writes and re-reads only its own columns of s, so no storage
+// barrier is needed between the two norms; the sums of squares use workgroup tree reductions.
+// All activations (a, r, s, y) are one merged binding: in-place outputs (s == r, y == s, ...) are
+// legal because every element is read and written by the same invocation.
+
+struct Params {
+    offset_a: u32,
+    offset_r: u32,
+    offset_s: u32,
+    offset_y: u32,
+    offset_w1: u32,
+    offset_w2: u32,
+
+    stride_a1: u32,
+    stride_a2: u32,
+    stride_a3: u32,
+    stride_r1: u32,
+    stride_r2: u32,
+    stride_r3: u32,
+    stride_s1: u32,
+    stride_s2: u32,
+    stride_s3: u32,
+    stride_y1: u32,
+    stride_y2: u32,
+    stride_y3: u32,
+
+    w1_ne0: u32,
+    w1_ne1: u32,
+    w1_ne2: u32,
+    w1_ne3: u32,
+    stride_w1_1: u32,
+    stride_w1_2: u32,
+    stride_w1_3: u32,
+    w2_ne0: u32,
+    w2_ne1: u32,
+    w2_ne2: u32,
+    w2_ne3: u32,
+    stride_w2_1: u32,
+    stride_w2_2: u32,
+    stride_w2_3: u32,
+
+    ne0: u32,
+    ne1: u32,
+    ne2: u32,
+    ne3: u32,
+
+    eps1: f32,
+    eps2: f32
+};
+
+@group(0) @binding(0) var<storage, read_write> act: array<f32>;
+#ifdef W_MERGED
+@group(0) @binding(1) var<uniform> params: Params;
+fn w1_at(i: u32) -> f32 { return act[i]; }
+fn w2_at(i: u32) -> f32 { return act[i]; }
+#else
+@group(0) @binding(1) var<storage, read_write> w1: array<f32>;
+#ifdef SECOND_NORM
+@group(0) @binding(2) var<storage, read_write> w2: array<f32>;
+@group(0) @binding(3) var<uniform> params: Params;
+fn w2_at(i: u32) -> f32 { return w2[i]; }
+#else
+@group(0) @binding(2) var<uniform> params: Params;
+#endif
+fn w1_at(i: u32) -> f32 { return w1[i]; }
+#endif
+
+var<workgroup> scratch: array<f32, WG_SIZE>;
+
+fn reduce_sum(lid: u32, v: f32) -> f32 {
+    scratch[lid] = v;
+    workgroupBarrier();
+    var offset: u32 = WG_SIZE / 2u;
+    while (offset > 0u) {
+        if (lid < offset) {
+            scratch[lid] += scratch[lid + offset];
+        }
+        offset = offset / 2u;
+        workgroupBarrier();
+    }
+    let total = scratch[0];
+    // scratch is reused by the next reduction
+    workgroupBarrier();
+    return total;
+}
+
+@compute @workgroup_size(WG_SIZE)
+fn main(@builtin(workgroup_id) wid: vec3<u32>,
+        @builtin(num_workgroups) num_wg: vec3<u32>,
+        @builtin(local_invocation_id) lid3: vec3<u32>) {
+    let lid = lid3.x;
+    var i = wid.x + wid.y * num_wg.x;
+    if (i >= params.ne1 * params.ne2 * params.ne3) {
+        return;
+    }
+    let i3 = i / (params.ne2 * params.ne1);
+    i = i % (params.ne2 * params.ne1);
+    let i2 = i / params.ne1;
+    let i1 = i % params.ne1;
+
+    let row_a = params.offset_a + i3 * params.stride_a3 + i2 * params.stride_a2 + i1 * params.stride_a1;
+    let row_r = params.offset_r + i3 * params.stride_r3 + i2 * params.stride_r2 + i1 * params.stride_r1;
+    let row_s = params.offset_s + i3 * params.stride_s3 + i2 * params.stride_s2 + i1 * params.stride_s1;
+    let row_w1 = params.offset_w1 + (i3 % params.w1_ne3) * params.stride_w1_3 +
