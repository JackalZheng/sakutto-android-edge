+// Sakutto patch 0025: RMS_NORM, MUL, ADD [, RMS_NORM, MUL] -> one row kernel (token fna).
+// Graph-shape checks only; buffer placement is checked when encoding (ggml_webgpu_sakutto_norm_add).
+// Returns the number of fused nodes (5 or 3), or 0.
+static int ggml_webgpu_sakutto_can_fuse_norm_add(const struct ggml_cgraph * cgraph, int node_idx) {
+    if (!ggml_webgpu_sakutto_fuse_norm_add) {
+        return 0;
+    }
+    const auto f32_rows = [](const ggml_tensor * t) {
+        return t->type == GGML_TYPE_F32 && t->nb[0] == sizeof(float) && ggml_is_contiguous_rows(t);
+    };
+    // MUL(norm, w) or MUL(w, norm) with w broadcast over norm's shape
+    const auto norm_mul_ok = [&](const ggml_tensor * norm, const ggml_tensor * mul, const ggml_tensor ** w) {
+        if (mul->src[0] == norm) {
+            *w = mul->src[1];
+        } else if (mul->src[1] == norm) {
+            *w = mul->src[0];
+        } else {
+            return false;
+        }
+        return f32_rows(norm->src[0]) && f32_rows(*w) && f32_rows(mul) && ggml_are_same_shape(mul, norm) &&
+               ggml_can_repeat(*w, norm);
+    };
+
+    if (node_idx + 3 > cgraph->n_nodes) {
+        return 0;
+    }
+    const ggml_tensor * norm1 = cgraph->nodes[node_idx];
+    const ggml_tensor * mul1  = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * add   = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * w1    = nullptr;
+    if (norm1->op != GGML_OP_RMS_NORM || mul1->op != GGML_OP_MUL || add->op != GGML_OP_ADD ||
+        !norm_mul_ok(norm1, mul1, &w1)) {
+        return 0;
+    }
+    const ggml_tensor * r = add->src[0] == mul1 ? add->src[1] : (add->src[1] == mul1 ? add->src[0] : nullptr);
+    if (r == nullptr || r == mul1 || !f32_rows(r) || !f32_rows(add) || !ggml_are_same_shape(r, add) ||
+        !ggml_are_same_shape(mul1, add)) {
+        return 0;
+    }
+
+    if (node_idx + 5 <= cgraph->n_nodes) {
+        const ggml_tensor * norm2 = cgraph->nodes[node_idx + 3];
+        const ggml_tensor * mul2  = cgraph->nodes[node_idx + 4];
+        const ggml_tensor * w2    = nullptr;
+        const int           outs[2] = { node_idx + 2, node_idx + 4 };
+        const ggml_op       ops[5]  = { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ADD, GGML_OP_RMS_NORM, GGML_OP_MUL };
+        if (norm2->op == GGML_OP_RMS_NORM && mul2->op == GGML_OP_MUL && norm2->src[0] == add &&
+            norm_mul_ok(norm2, mul2, &w2) && ggml_can_fuse_subgraph(cgraph, node_idx, 5, ops, outs, 2)) {
+            return 5;
+        }
+    }
+    const int     outs3[1] = { node_idx + 2 };
+    const ggml_op ops3[3]  = { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ADD };
+    return ggml_can_fuse_subgraph(cgraph, node_idx, 3, ops3, outs3, 1) ? 3 : 0;
+}
