+// llama.cpp (ggml-opencl gemv_noshuffle_q4_k_f32.cl: wide contiguous weight loads per fiber, dequant
+// in registers, one cross-fiber reduction at the end) and TVM dlight's Adreno GEMV schedule
+// (64 threads, a few rows per workgroup, 8+ contiguous reduction elements per thread).
+//
+// Each thread takes whole 16-byte chunks of a q4_K block (32 weights) with one vec4<u32> load, plus
+// the block's 16-byte header (d, dmin, 12 scale bytes) with a second vec4<u32> load; src1 is read as
+// vec4<f32>. Groups of TPR threads share a row; WG_SIZE / TPR groups work on different rows; a group
+// handles ROWS_PER_GROUP rows, reusing the src1 registers. No subgroup operations.
+//
+// GLU: fused SWIGLU of a gate+up product (after ggml-opencl's fused mat-vec + GLU): output row o
+// takes weight rows o (gate) and o + m (up); params.m is the GLU output width.
+//
+// Requires: src1 offset, row stride and batch strides multiple of 4 floats (host checks), K % 256 == 0.
+
+enable f16;
+
+struct MulMatParams {
+    offset_src0: u32,
+    offset_src1: u32,
+    offset_dst: u32,
+    m: u32,
+    n: u32,
+    k: u32,
+    stride_01: u32,
+    stride_11: u32,
+    stride_02: u32,
+    stride_12: u32,
+    stride_03: u32,
+    stride_13: u32,
+    bs02: u32,
+    bs03: u32,
+    broadcast2: u32,
+    broadcast3: u32
+};
+
+@group(0) @binding(0) var<storage, read_write> src0: array<vec4<u32>>;
+@group(0) @binding(1) var<storage, read_write> src1: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> dst: array<f32>;
+@group(0) @binding(3) var<uniform> params: MulMatParams;
+
+const GROUPS: u32 = WG_SIZE / TPR;
+const OUTPUTS: u32 = GROUPS * ROWS_PER_GROUP;
+// q4_K block: 144 bytes = 9 vec4<u32>: header (d|dmin, scales[0..11]) then 8 quant chunks.
+const BLOCK_VEC4: u32 = 9u;
+
+#ifdef GLU
+const PRODUCTS: u32 = 2u;
+#else
+const PRODUCTS: u32 = 1u;
+#endif
+var<workgroup> partial_sums: array<f32, OUTPUTS * TPR * PRODUCTS>;
+
+fn scale_byte(h: vec4<u32>, i: u32) -> u32 {
+    // scales[i] = byte i of h.y, h.z, h.w
+    let w = select(select(h.w, h.z, i < 8u), h.y, i < 4u);
+    return (w >> (8u * (i & 3u))) & 0xFFu;
+}
+
+// get_scale_min_k4 (ggml-quants.c) for sub-block j: (scale, min)
+fn scale_min(h: vec4<u32>, j: u32) -> vec2<f32> {
+    if (j < 4u) {
+        return vec2<f32>(f32(scale_byte(h, j) & 63u), f32(scale_byte(h, j + 4u) & 63u));
+    }
+    let q4 = scale_byte(h, j + 4u);
+    let sc = (q4 & 0xFu) | ((scale_byte(h, j - 4u) >> 6u) << 4u);
+    let mn = (q4 >> 4u) | ((scale_byte(h, j) >> 6u) << 4u);
+    return vec2<f32>(f32(sc), f32(mn));
+}
+
+fn nibbles_lo(w: u32) -> vec4<f32> {
+    return vec4<f32>(f32(w & 0xFu), f32((w >> 8u) & 0xFu), f32((w >> 16u) & 0xFu), f32((w >> 24u) & 0xFu));
+}
+
+fn nibbles_hi(w: u32) -> vec4<f32> {
+    return vec4<f32>(f32((w >> 4u) & 0xFu), f32((w >> 12u) & 0xFu), f32((w >> 20u) & 0xFu), f32((w >> 28u) & 0xFu));
