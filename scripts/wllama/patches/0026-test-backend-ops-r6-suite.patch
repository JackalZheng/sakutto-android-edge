+    // src1 padded row stride (multiple of 4) and permuted
+    test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q4_K, GGML_TYPE_F32, 768, 1, 512, {1, 1}, {1, 1}, {0, 1, 2, 3}, 768));
+    test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q4_K, GGML_TYPE_F32, 768, 1, 512, {1, 1}, {1, 1}, {0, 1, 2, 3}, 1024));
+    test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q4_K, GGML_TYPE_F32, 64, 1, 256, {3, 2}, {1, 1}, {0, 2, 1, 3}));
+    test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q4_K, GGML_TYPE_F16, 512, 1, 512, {1, 1}, {1, 1}));
+
+    // fused gate+up mat-vec + SWIGLU
+    test_cases.emplace_back(new test_sakutto_mv_swiglu(GGML_TYPE_Q4_K, 6144, 1536));
+    test_cases.emplace_back(new test_sakutto_mv_swiglu(GGML_TYPE_Q4_K, 1001, 512));
+    test_cases.emplace_back(new test_sakutto_mv_swiglu(GGML_TYPE_Q4_K, 64, 2560));
+    test_cases.emplace_back(new test_sakutto_mv_swiglu(GGML_TYPE_Q4_K, 512, 512, 1, true));
+    test_cases.emplace_back(new test_sakutto_mv_swiglu(GGML_TYPE_Q4_K, 512, 512, 3));
+    test_cases.emplace_back(new test_sakutto_mv_swiglu(GGML_TYPE_Q6_K, 512, 512));
+
+    // fused post-norm chain
+    const std::array<int64_t, 4> nes[] = { { 1536, 1, 1, 1 }, { 1536, 7, 1, 1 }, { 1000, 3, 1, 1 }, { 64, 5, 4, 3 }, { 4096, 2, 1, 1 } };
+    for (const auto & ne : nes) {
+        for (bool second : { true, false }) {
+            test_cases.emplace_back(new test_sakutto_norm_add(ne, second));
+            test_cases.emplace_back(new test_sakutto_norm_add(ne, second, true, true, true));
+            test_cases.emplace_back(new test_sakutto_norm_add(ne, second, false, false, true));
+            test_cases.emplace_back(new test_sakutto_norm_add(ne, second, false, false, false, true));
+            test_cases.emplace_back(new test_sakutto_norm_add(ne, second, false, false, false, false, false));
+        }
+    }
+    // upstream fusion tests on the same path
+    test_cases.emplace_back(new test_rms_norm_mul_add(GGML_TYPE_F32, {1536, 1, 1, 1}));
+    test_cases.emplace_back(new test_rms_norm_mul_add(GGML_TYPE_F32, {64, 5, 4, 3}, 1e-6f, false, false, false, false, true));
+    test_cases.emplace_back(new test_rms_norm_mul_add(GGML_TYPE_F32, {64, 5, 4, 3}, 1e-6f, false, true));
+    test_cases.emplace_back(new test_rms_norm_mul_add(GGML_TYPE_F32, {64, 5, 4, 3}, 1e-6f, false, false, false, true));
+    return test_cases;
+}
