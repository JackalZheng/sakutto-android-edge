         throw app_exception("kv_overrides_keys and kv_overrides_vals must have the same length");
       for (size_t i = 0; i < keys.size(); i++)
+      {
+        // Sakutto debug harness: "sakutto.tensor_buft_overrides" carries
+        // llama.cpp -ot style "regex=BUFT[,regex=BUFT...]" rules instead of a
+        // GGUF metadata override (no glue message change needed).
+        if (keys[i] == "sakutto.tensor_buft_overrides")
+        {
+          sakutto_parse_tensor_buft_overrides(vals[i], params);
+          continue;
+        }
