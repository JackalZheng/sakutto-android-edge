+static std::vector<std::unique_ptr<test_case>> make_test_cases_sakutto_mulmat() {
+    std::vector<std::unique_ptr<test_case>> test_cases;
+    const int64_t ns[] = { 5, 6, 7, 8, 9, 12, 16, 31, 32, 33, 38, 41, 63, 64, 65, 96, 128, 256, 512 };
+    struct weight_shape { ggml_type type; int64_t m; int64_t k; };
+    const weight_shape weights[] = {
+        { GGML_TYPE_Q4_K, 2304, 1536 }, // PLaMo 3 attn_qkv
+        { GGML_TYPE_Q6_K, 1536, 6144 }, // PLaMo 3 ffn_down
