+        { GGML_TYPE_Q6_K, 1003, 768  }, // odd rows
+        { GGML_TYPE_F16,  1024, 1024 },
+        { GGML_TYPE_F16,  1001, 516  }, // odd rows, k % 8 != 0
+        { GGML_TYPE_F32,  257,  256  },
+        { GGML_TYPE_Q8_0, 1024, 1024 }, // Qwen3
+        { GGML_TYPE_Q5_0, 1152, 1152 }, // Gemma 3
+        { GGML_TYPE_Q4_0, 1000, 1024 },
+        { GGML_TYPE_Q5_K, 512,  1024 },
+    };
+    for (const auto & w : weights) {
+        for (int64_t n : ns) {
+            test_cases.emplace_back(new test_mul_mat(w.type, GGML_TYPE_F32, w.m, n, w.k, {1, 1}, {1, 1}));
+        }
+    }
+    for (int64_t n : { (int64_t) 5, (int64_t) 38, (int64_t) 64 }) {
+        // src1 rows padded (row stride k_v > k)
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q4_K, GGML_TYPE_F32, 768, n, 512, {1, 1}, {1, 1}, {0, 1, 2, 3}, 768));
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_F16, GGML_TYPE_F32, 768, n, 512, {1, 1}, {1, 1}, {0, 1, 2, 3}, 768));
+        // f16 activations
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_F16, GGML_TYPE_F16, 512, n, 256, {1, 1}, {1, 1}));
+        // batched (not taken by the batched mat-vec; stays on the tiled shader)
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_F16, GGML_TYPE_F32, 128, n, 256, {4, 1}, {2, 1}));
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q4_K, GGML_TYPE_F32, 256, n, 256, {2, 1}, {1, 1}));
+        // real-checkpoint weight scale
+        test_cases.emplace_back(new test_mul_mat_small_weights(GGML_TYPE_Q6_K, 2304, n, 1536, 0.02f));
+        test_cases.emplace_back(new test_mul_mat_small_weights(GGML_TYPE_Q4_K, 2304, n, 1536, 0.02f));
+    }
+    return test_cases;
+}
