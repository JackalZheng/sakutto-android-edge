+static bool ggml_webgpu_sakutto_use_batched_mv(webgpu_context & ctx,
+                                               ggml_tensor *    src0,
+                                               ggml_tensor *    src1,
+                                               ggml_tensor *    dst) {
+    const int64_t n = dst->ne[1];
+    if (ggml_webgpu_sakutto_bmv_max_n == 0 || n <= GGML_WEBGPU_MUL_MAT_VEC_MAX_ROWS ||
+        n > (int64_t) ggml_webgpu_sakutto_bmv_max_n || ctx->global_ctx->disable_mat_vec) {
+        return false;
+    }
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1) {
+        return false;
+    }
+    if (src1->type != GGML_TYPE_F32 && src1->type != GGML_TYPE_F16) {
+        return false;
+    }
+    if (dst->type != GGML_TYPE_F32 || dst->nb[1] != (size_t) dst->ne[0] * sizeof(float) ||
+        src1->nb[0] != ggml_type_size(src1->type)) {
+        return false;
+    }
+    if (ggml_webgpu_tensor_binding_overlap(ctx->global_ctx, src0, src1)) {
+        return false;
+    }
+    return true;
+}
